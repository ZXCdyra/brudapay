# ============================================
# Backend + Telegram Bot Dockerfile для Render
# ============================================
# Запускает Go API и Telegram Bot вместе
# ============================================

FROM golang:1.23-alpine AS backend-builder

WORKDIR /app

# Копируем go модули
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Копируем код бэкенда
COPY backend .

# Собираем бэкенд
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /paymentsgate ./cmd/server

# ============================================
# Финальный образ
# ============================================
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata curl python3 py3-pip

WORKDIR /app

# Копируем бэкенд
COPY --from=backend-builder /paymentsgate .

# Копируем миграции
COPY backend/migrations ./migrations

# Копируем Telegram бота
COPY telegram_bot.py .

# Устанавливаем Python зависимости
RUN pip3 install --break-system-packages --no-cache-dir python-telegram-bot

# Порт для API
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Переменные окружения
ENV PORT=8080
ENV SERVER_PORT=8080

# Запускаем бэкенд и бота
CMD ["/bin/sh", "-c", "/app/paymentsgate >> /tmp/server.log 2>&1 & sleep 5 && grep -q 'Listening' /tmp/server.log && echo 'Server started OK' || (cat /tmp/server.log && echo 'Server failed to start') && python3 telegram_bot.py"]
