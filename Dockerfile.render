# ============================================
# Frontend builder
# ============================================
FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install && npm cache clean --force

COPY frontend .

RUN npm run build

# ============================================
# Backend builder
# ============================================
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /paymentsgate ./cmd/server

# ============================================
# Final image
# ============================================
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata curl python3 py3-pip

WORKDIR /app

COPY --from=backend-builder /paymentsgate .
COPY backend/migrations ./migrations
COPY --from=frontend-builder /app/.next/standalone ./frontend/.next/standalone
COPY --from=frontend-builder /app/.next/static ./frontend/.next/static
COPY --from=frontend-builder /app/public ./frontend/public
COPY telegram_bot.py .

RUN pip3 install --break-system-packages --no-cache-dir python-telegram-bot

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENV PORT=8080
ENV SERVER_PORT=8080

CMD ["/bin/sh", "-c", "FRONTEND_DIR=./frontend/.next/standalone /app/paymentsgate >> /tmp/server.log 2>&1 & sleep 5 && cat /tmp/server.log && python3 telegram_bot.py"]
