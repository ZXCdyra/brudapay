# ============================================
# Переменные окружения для Zeabur
# ============================================
# Скопируйте этот файл в .env и заполните значения
# ============================================

# --- База данных (PostgreSQL) ---
DB_USER=paymentsgate
DB_PASSWORD=paymentsgate
DB_NAME=paymentsgate

# --- Сервер ---
ENVIRONMENT=production
BASE_URL=https://your-app.zeabur.app

# --- JWT Секреты (СГЕНЕРИРУЙТЕ СВОИ!) ---
# Команды для генерации:
# openssl rand -hex 32
JWT_ACCESS_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# --- Шифрование (ровно 32 символа!) ---
# Команда для генерации:
# openssl rand -hex 16
ENCRYPTION_KEY=your-32-byte-encryption-key

# --- Лимиты ---
RATE_LIMIT_RPS=100

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DISPUTE_CHAT_ID=your-telegram-chat-id

# --- PostgreSQL (для локальной разработки) ---
# На Zeabur эти переменные создаются автоматически
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
